# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server only. Bypasses RLS: never expose it, never pass it as a build argument.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── App URL (required) ───────────────────────────────────────────────────────
# Used for OAuth, email confirmation and Stripe return URLs. Trailing slashes
# are stripped.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Scheduled jobs (required in production) ──────────────────────────────────
# Sent as "Authorization: Bearer <secret>" to /api/cron/*. Without it those
# routes refuse every request in production. Generate: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# ── Email: Resend (optional; emails are skipped if unset) ────────────────────
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=hello@yourdomain.com

# ── AI: OpenRouter (optional; server-side only) ──────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
# Shown to OpenRouter as the app name
# OPENROUTER_APP_NAME=My SaaS

# ── Billing: Stripe (optional; the Billing tab says it is not set up) ────────
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
# A recurring per-seat price; quantity = the organization's workspace seats
STRIPE_PRICE_ID_TENANT_SEAT=your_stripe_recurring_price_id

# ── Web Push (optional) — generate with: npx web-push generate-vapid-keys ────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
