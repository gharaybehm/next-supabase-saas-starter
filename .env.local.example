NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URL (used for building invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Dropbox Sign (HelloSign) ─────────────────────────────────────────────────
# The agreement document is read from legal/agreement.md at runtime — no
# template upload needed. Just provide your API key and webhook secret.
DROPBOX_SIGN_API_KEY=your_dropbox_sign_api_key
DROPBOX_SIGN_WEBHOOK_SECRET=your_webhook_secret

# ── Platform identity (fills the "Platform" party in the agreement) ───────────
PLATFORM_NAME=Micro MLS
PLATFORM_ADDRESS=Dubai, UAE
PLATFORM_REP=Platform Administrator

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# ── AI (optional) ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key

# ── Cron secret ──────────────────────────────────────────────────────────────
CRON_SECRET=your_random_secret_here

# ── Filebase (S3-compatible decentralized storage for listing images) ────────
# Create a bucket + access key/secret at https://filebase.com. Confirm
# FILEBASE_PUBLIC_BASE_URL against the bucket's public access settings in the
# Filebase dashboard before relying on it in production.
FILEBASE_ACCESS_KEY_ID=your_filebase_access_key
FILEBASE_SECRET_ACCESS_KEY=your_filebase_secret_key
FILEBASE_BUCKET=listing-images
FILEBASE_ENDPOINT=https://s3.filebase.com
FILEBASE_REGION=us-east-1
FILEBASE_PUBLIC_BASE_URL=https://your-bucket.s3.filebase.com
