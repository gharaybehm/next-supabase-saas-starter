NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URL (used for building invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Dropbox Sign (HelloSign) ─────────────────────────────────────────────────
# The agreement document is read from legal/agreement.md at runtime — no
# template upload needed. Just provide your API key and webhook secret.
DROPBOX_SIGN_API_KEY=your_dropbox_sign_api_key
DROPBOX_SIGN_WEBHOOK_SECRET=your_webhook_secret

# ── Platform identity (fills the "Platform" party in the agreement) ───────────
PLATFORM_NAME=Micro MLS
PLATFORM_ADDRESS=Dubai, UAE
PLATFORM_REP=Platform Administrator

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# ── Resend (invite emails) ────────────────────────────────────────────────────
# Get an API key at https://resend.com. Sending to arbitrary recipients
# requires a verified sending domain — until then Resend only delivers to the
# account owner's own address. RESEND_FROM_EMAIL must be on the verified domain.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=invites@yourdomain.com

# ── AI (optional) ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key

# ── Cron secret ──────────────────────────────────────────────────────────────
CRON_SECRET=your_random_secret_here

# ── Filebase (S3-compatible gateway to IPFS for listing images) ──────────────
# Create a bucket + access key/secret at https://filebase.com. Filebase pins
# objects to IPFS and serves them via a CID-based gateway URL (not a plain
# path-based one) — FILEBASE_GATEWAY_URL + the object's stored `cid` builds it.
FILEBASE_ACCESS_KEY_ID=your_filebase_access_key
FILEBASE_SECRET_ACCESS_KEY=your_filebase_secret_key
FILEBASE_BUCKET=listing-images
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=us-east-1
FILEBASE_GATEWAY_URL=https://ipfs.filebase.io/ipfs
